NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FZ0C6Q39YB
NEXT_PUBLIC_CLARITY_PROJECT_ID=wpvmnypbla

# Product rollout flags. Keep legacy visa flow enabled until the migration
# cutover tasks explicitly retire it.
NEXT_PUBLIC_FEATURE_LEGACY_VISA_FLOW=true
NEXT_PUBLIC_FEATURE_PUBLIC_JOBS=false
NEXT_PUBLIC_FEATURE_CV_RESUME_TAILORING=false
NEXT_PUBLIC_FEATURE_JOB_INTERVIEWS=false
NEXT_PUBLIC_FEATURE_APPLICATION_TRACKING=false
NEXT_PUBLIC_FEATURE_NATIVE_APPLICATIONS=false

# Protected admin operations. Leave blank to fail closed. Use comma-separated
# emails or Supabase user IDs; legacy JOBREADY_ADMIN_EMAILS/USER_IDS map to editor.
JOBREADY_ADMIN_OWNER_EMAILS=""
JOBREADY_ADMIN_OWNER_USER_IDS=""
JOBREADY_ADMIN_EDITOR_EMAILS=""
JOBREADY_ADMIN_EDITOR_USER_IDS=""
JOBREADY_ADMIN_REVIEWER_EMAILS=""
JOBREADY_ADMIN_REVIEWER_USER_IDS=""
JOBREADY_ADMIN_JOB_EDITOR_EMAILS=""
JOBREADY_ADMIN_JOB_EDITOR_USER_IDS=""
JOBREADY_ADMIN_ANALYST_EMAILS=""
JOBREADY_ADMIN_ANALYST_USER_IDS=""

# Transactional email through Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Jiandae <welcome@jiandae.co.ke>"
RESEND_REPLY_TO_EMAIL="support@jiandae.co.ke"

# Azure AI Foundry / Azure OpenAI is the default LLM provider.
LLM_PROVIDER="azure-foundry"
AZURE_OPENAI_API_KEY=""
# Either the resource endpoint or a full chat completions URL is accepted.
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# Optional DeepSeek provider if LLM_PROVIDER="deepseek".
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# Optional direct OpenAI fallback if LLM_PROVIDER="openai".
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Azure OpenAI Realtime deployment used for spoken interviews. The endpoint
# may be copied directly from Azure, including its ?model= deployment query.
AZURE_OPENAI_REALTIME_ENDPOINT="https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/v1/realtime?model=YOUR_REALTIME_DEPLOYMENT"
AZURE_OPENAI_REALTIME_DEPLOYMENT="YOUR_REALTIME_DEPLOYMENT"
# Optional if the realtime deployment uses a different resource/key.
AZURE_OPENAI_REALTIME_API_KEY=""
AZURE_OPENAI_REALTIME_VOICE="alloy"
AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL="YOUR_TRANSCRIPTION_DEPLOYMENT"

# Optional officer question audio.
# Use "disabled", "openai", "azure-openai", or "elevenlabs". If unset,
# OpenAI TTS is used only when OPENAI_API_KEY is configured; otherwise question
# audio stays disabled.
QUESTION_AUDIO_PROVIDER=""
QUESTION_AUDIO_MODEL="gpt-4o-mini-tts"
QUESTION_AUDIO_VOICE="cedar"
QUESTION_AUDIO_INSTRUCTIONS="Speak as a calm, professional interviewer. Use a direct interview tone, clear pacing, and natural pauses."
# Required only when QUESTION_AUDIO_PROVIDER="azure-openai".
AZURE_OPENAI_TTS_API_KEY=""
AZURE_OPENAI_TTS_ENDPOINT=""
AZURE_OPENAI_TTS_DEPLOYMENT=""
AZURE_OPENAI_TTS_API_VERSION="2025-01-01-preview"

# Required only when QUESTION_AUDIO_PROVIDER="elevenlabs".
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
# Optional ElevenLabs voice tuning overrides.
ELEVENLABS_STABILITY=""
ELEVENLABS_SIMILARITY_BOOST=""
ELEVENLABS_STYLE=""
ELEVENLABS_SPEED=""
ELEVENLABS_USE_SPEAKER_BOOST=""

# Cloudflare R2 candidate document storage. Keep every R2 value server-only;
# never create NEXT_PUBLIC_* R2 variables.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_QUARANTINE="jobready-document-quarantine-development"
R2_BUCKET_CANDIDATE_DOCUMENTS="jobready-candidate-documents-development"
R2_BUCKET_EXPORTS="jobready-document-exports-development"
R2_ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
R2_ALLOWED_UPLOAD_CONTENT_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
R2_MAX_UPLOAD_BYTES="10485760"
R2_UPLOAD_RESERVATION_TTL_SECONDS="900"
R2_UPLOAD_PRESIGN_TTL_SECONDS="300"
R2_DOWNLOAD_PRESIGN_TTL_SECONDS="300"
R2_UPLOAD_RATE_LIMIT_WINDOW_SECONDS="60"
R2_UPLOAD_RATE_LIMIT_MAX_RESERVATIONS="8"
R2_DOCUMENT_EVENTS_QUEUE_NAME="jobready-document-events-development"
R2_QUARANTINE_LIFECYCLE_DAYS="1"

# Candidate document ingestion. Keep real uploads disabled until D10 legal/data
# location approval is complete.
DOCUMENT_REAL_UPLOADS_ENABLED=false
DOCUMENT_SCANNER_PROVIDER="jobready-deterministic-scanner"
DOCUMENT_SCANNER_VERSION="task07-v1"
DOCUMENT_PARSER_PROVIDER="jobready-deterministic-parser"
DOCUMENT_PARSER_VERSION="task07-v1"
DOCUMENT_FACT_SCHEMA_VERSION="candidate-facts.task07.v1"

# Payments. Flutterwave is the default; set PAYMENT_PROVIDER="stripe" to switch back.
PAYMENT_PROVIDER="flutterwave"

# Flutterwave webhook URL. Use the canonical www host to avoid POST redirects.
# https://www.jiandae.co.ke/api/flutterwave/webhook
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# Stripe webhook URL:
# https://YOUR_DOMAIN/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
