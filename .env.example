# Transactional email through Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Jiandae <welcome@jiandae.africa>"
RESEND_REPLY_TO_EMAIL="support@jiandae.africa"

# One server-only OpenAI API key for CV editing, interviews, and all audio.
# If OPENAI_API_KEY is already set in the server environment, reuse it.
OPENAI_API_KEY=""
# Optional model and voice settings; defaults work with the same key.
OPENAI_MODEL="gpt-4o-mini"
OPENAI_REALTIME_MODEL="gpt-realtime-mini"
OPENAI_REALTIME_VOICE="alloy"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="cedar"
QUESTION_AUDIO_ENABLED="true"
QUESTION_AUDIO_INSTRUCTIONS="Speak as a calm, professional interviewer. Use a direct interview tone, clear pacing, and natural pauses."

# Cloudflare R2 candidate document storage. Keep every R2 value server-only;
# never create NEXT_PUBLIC_* R2 variables.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_QUARANTINE="jobready-document-quarantine-development"
R2_BUCKET_CANDIDATE_DOCUMENTS="jobready-candidate-documents-development"
R2_BUCKET_EXPORTS="jobready-document-exports-development"
R2_ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
R2_ALLOWED_UPLOAD_CONTENT_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
R2_MAX_UPLOAD_BYTES="10485760"
R2_UPLOAD_RESERVATION_TTL_SECONDS="900"
R2_UPLOAD_PRESIGN_TTL_SECONDS="300"
R2_DOWNLOAD_PRESIGN_TTL_SECONDS="300"
R2_UPLOAD_RATE_LIMIT_WINDOW_SECONDS="60"
R2_UPLOAD_RATE_LIMIT_MAX_RESERVATIONS="8"
R2_DOCUMENT_EVENTS_QUEUE_NAME="jobready-document-events-development"
R2_QUARANTINE_LIFECYCLE_DAYS="1"

# Candidate document ingestion. Keep real uploads disabled until D10 legal/data
# location approval is complete.
DOCUMENT_REAL_UPLOADS_ENABLED=false
DOCUMENT_SCANNER_PROVIDER="jobready-deterministic-scanner"
DOCUMENT_SCANNER_VERSION="task07-v1"
DOCUMENT_PARSER_PROVIDER="jobready-deterministic-parser"
DOCUMENT_PARSER_VERSION="task07-v1"
DOCUMENT_FACT_SCHEMA_VERSION="candidate-facts.task07.v1"

# Payments. Flutterwave is the default; set PAYMENT_PROVIDER="stripe" to switch back.
PAYMENT_PROVIDER="flutterwave"

# Flutterwave webhook URL. Use the primary host to avoid POST redirects.
