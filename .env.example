NEXT_PUBLIC_FEATURE_JOB_INTERVIEWS=false
NEXT_PUBLIC_FEATURE_APPLICATION_TRACKING=false
NEXT_PUBLIC_FEATURE_NATIVE_APPLICATIONS=false

# Protected admin operations. Leave blank to fail closed. Use comma-separated
# emails or Supabase user IDs; legacy JOBREADY_ADMIN_EMAILS/USER_IDS map to editor.
