generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  ongoing
  completed
}

enum MessageRole {
  user
  ai
  system
}

enum OnboardingInputType {
  text
  textarea
  select
  multiselect
  number
}

enum PaymentProvider {
  stripe
  flutterwave
}

enum RealtimeInterviewStatus {
  pending
  active
  finalizing
  completed
  failed
}

enum InterviewSessionKind {
  legacy_visa
  job_interview
}

enum ContentSourceType {
  direct_employer
  verified_partner
  authorized_feed
  official_career_page
  company_site
  annual_report
  public_job_board
  candidate_submitted
  internal_fixture
  other
}

enum ContentStatus {
  draft
  needs_review
  published
  retired
}

enum ConfidenceLevel {
  low
  medium
  high
}

enum JobPostingStatus {
  draft
  needs_review
  published
  expired
  closed
  retired
  rejected
}

enum WorkType {
  onsite
  hybrid
  remote
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
  temporary
  graduate_trainee
  volunteer
  other
}

enum SalaryPeriod {
  hourly
  daily
  monthly
  yearly
  project
}

enum JobSkillImportance {
  required
  preferred
}

enum PublicationReviewDecision {
  pending
  approved
  rejected
  expired
  retired
}

enum JobApplicationUrlVerificationStatus {
  unchecked
  verified
  warning
  blocked
}

enum JobPostingAuditAction {
  draft_created
  version_created
  review_recorded
  duplicate_flagged
  publication_blocked
  published
  expired
  closed
  retired
  rejected
  freshness_check_recorded
}

enum CandidateDocumentKind {
  cv
  resume
  other
}

enum CandidateDocumentStatus {
  active
  deleted
}

enum CandidateDocumentVersionStatus {
  quarantined
  pending_scan
  scan_failed
  clean
  infected
  parsing_failed
  parsed
  exported
  deleted
}

enum DocumentScanStatus {
  pending
  clean
  infected
  failed
  skipped
}

enum DocumentUploadReservationStatus {
  reserved
  used
  expired
  cancelled
  rejected
}

enum DocumentProcessingEventStatus {
  processing
  succeeded
  failed
}

enum CandidateFactType {
  experience
  education
  skill
  project
  certification
  achievement
  other
}

enum CandidateFactEvidenceSource {
  document
  user_confirmation
}

enum TailoringTargetType {
  public_job
  private_target
  company_role_only
}

enum TailoringStatus {
  queued
  running
  needs_user_input
  completed
  failed
  cancelled
}

enum TailoringEditDecisionType {
  accepted
  rejected
  user_edited
}

enum TailoringExportFormat {
  docx
  pdf
}

enum ApplicationStatus {
  interested
  applied
  screening
  interview
  offer
  rejected
  withdrawn
}

enum InterviewFocusMode {
  recommended
  behavioral_focus
  role_specific_focus
  custom
}

enum InterviewMode {
  text
  voice
}

enum FollowUpIntent {
  ownership
  result
  mechanism
  example
  trade_off
  clarification
  other
}

enum StarComponentStatus {
  not_applicable
  missing
  vague
  present
  strong
}

enum CreditLedgerAction {
  grant
  reserve
  consume
  release
  refund
  expire
  adjust
}

enum LedgerProductAction {
  interview
  tailoring
}

enum PurchaseFulfillmentState {
  pending
  fulfilled
  failed
  refunded
}

enum ModelOperation {
  interview_question
  answer_evaluation
  report_generation
  realtime_session
  transcription
  question_audio
  document_parsing
  cv_tailoring
  job_extraction
}

enum ModelModality {
  text
  audio
  document
  image
}

enum StorageOperation {
  reserve_upload
  quarantine_put
  scan
  copy_to_private
  presign_download
  export_write
  delete_object
  lifecycle_cleanup
}

model User {
  id                         String                               @id @db.Uuid
  name                       String?
  email                      String?
  emailVerified              DateTime?
  image                      String?
  credits                    Int                                  @default(1)
  welcomeEmailSentAt         DateTime?
  resendContactSyncedAt      DateTime?
  createdAt                  DateTime                             @default(now())
  interviews                 InterviewSession[]
  purchases                  Purchase[]
  referredPurchases          Purchase[]                           @relation("ReferralPurchases")
  reviewedContent            ContentReview[]                      @relation("ContentReviewReviewer")
  jobPostingAuditEvents      JobPostingAuditEvent[]               @relation("JobPostingAuditActor")
  submittedJobSources        JobSource[]                          @relation("CandidateSubmittedJobSources")
  privateJobTargets          PrivateJobTarget[]
  candidateDocuments         CandidateDocument[]
  documentVersions           CandidateDocumentVersion[]
  documentUploadReservations CandidateDocumentUploadReservation[]
  documentProcessingEvents   CandidateDocumentProcessingEvent[]
  candidateFacts             CandidateFact[]
  tailoringRuns              TailoringRun[]
  tailoringDecisions         TailoringEditDecision[]
  tailoringExports           TailoringExport[]
  savedJobs                  SavedJob[]
  jobApplications            JobApplication[]
  statusEvents               ApplicationStatusEvent[]
  outboundEvents             ApplicationOutboundEvent[]
  creditLedgerEntries        CreditLedgerEntry[]
  modelUsages                ModelUsage[]
  storageUsages              StorageUsage[]

  @@index([email])
}

model Country {
  id                 String             @id @default(cuid())
  name               String
  isoCode            String             @unique
  flagEmoji          String?
  originProfile      String?            @db.Text
  isDestination      Boolean            @default(false)
  isOrigin           Boolean            @default(true)
  isActive           Boolean            @default(true)
  visaTypes          VisaType[]         @relation("DestinationCountryVisaTypes")
  interviewsAsOrigin InterviewSession[] @relation("OriginCountryInterviews")
}

model VisaCategory {
  id          String            @id @default(cuid())
  slug        String            @unique
  label       String
  description String?
  visaTypes   VisaType[]
  fields      OnboardingField[]
}

model VisaType {
  id                   String             @id @default(cuid())
  destinationCountryId String
  categoryId           String
  name                 String
  basePrompt           String             @db.Text
  isActive             Boolean            @default(true)
  destinationCountry   Country            @relation("DestinationCountryVisaTypes", fields: [destinationCountryId], references: [id], onDelete: Cascade)
  category             VisaCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documents            RequiredDocument[]
  concernOptions       ConcernOption[]
  interviews           InterviewSession[]

  @@unique([destinationCountryId, name])
}

model OnboardingField {
  id             String              @id @default(cuid())
  visaCategoryId String
  key            String
  label          String
  placeholder    String?
  inputType      OnboardingInputType @default(textarea)
  required       Boolean             @default(false)
  displayOrder   Int                 @default(0)
  visaCategory   VisaCategory        @relation(fields: [visaCategoryId], references: [id], onDelete: Cascade)

  @@unique([visaCategoryId, key])
  @@index([visaCategoryId, displayOrder])
}

model RequiredDocument {
  id           String   @id @default(cuid())
  visaTypeId   String
  name         String
  description  String?  @db.Text
  isMandatory  Boolean  @default(true)
  displayOrder Int      @default(0)
  visaType     VisaType @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@index([visaTypeId, displayOrder])
}

model ConcernOption {
  id           String   @id @default(cuid())
  visaTypeId   String
  label        String
  displayOrder Int      @default(0)
  visaType     VisaType @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@unique([visaTypeId, label])
  @@index([visaTypeId, displayOrder])
}

model Market {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  isoCode           String             @unique
  currencyCode      String?
  timezone          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  companies         Company[]
  jobRoles          JobRole[]
  jobPostings       JobPosting[]
  privateJobTargets PrivateJobTarget[]
  interviewPlans    InterviewPlan[]
  interviewSessions InterviewSession[]
}

model Industry {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  companies   Company[]
  questions   Question[]
}

model Company {
  id                String             @id @default(cuid())
  slug              String             @unique
  legalName         String?
  displayName       String
  industryId        String?
  marketId          String
  websiteUrl        String?
  careersUrl        String?
  summary           String?            @db.Text
  focusAreas        String[]           @default([])
  publicationStatus ContentStatus      @default(draft)
  confidence        ConfidenceLevel    @default(low)
  reviewedAt        DateTime?
  nextReviewAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  industry          Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  market            Market             @relation(fields: [marketId], references: [id], onDelete: Restrict)
  jobRoles          JobRole[]
  jobPostings       JobPosting[]
  privateTargets    PrivateJobTarget[]
  interviewPlans    InterviewPlan[]
  interviewSessions InterviewSession[]
  questionCompanies QuestionCompany[]
  contentReviews    ContentReview[]

  @@index([marketId, publicationStatus])
  @@index([industryId])
  @@index([displayName])
}

model RoleFamily {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  description       String?            @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  jobRoles          JobRole[]
  jobPostings       JobPosting[]
  interviewPlans    InterviewPlan[]
  interviewSessions InterviewSession[]
  questionRoles     QuestionRole[]
}

model JobRole {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  roleFamilyId      String
  companyId         String?
  marketId          String?
  description       String?            @db.Text
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roleFamily        RoleFamily         @relation(fields: [roleFamilyId], references: [id], onDelete: Restrict)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  market            Market?            @relation(fields: [marketId], references: [id], onDelete: SetNull)
  aliases           JobTitleAlias[]
  jobPostings       JobPosting[]
  privateTargets    PrivateJobTarget[]
  interviewPlans    InterviewPlan[]
  interviewSessions InterviewSession[]
  questionRoles     QuestionRole[]

  @@index([roleFamilyId, isActive])
  @@index([companyId])
  @@index([marketId])
}

model JobTitleAlias {
  id        String   @id @default(cuid())
  jobRoleId String
  alias     String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  jobRole   JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, alias, locale])
  @@index([alias])
}

model Skill {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  aliases          String[]          @default([])
  description      String?           @db.Text
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobPostingSkills JobPostingSkill[]
  candidateFacts   CandidateFact[]
}

model Competency {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  description            String?                @db.Text
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  jobPostingCompetencies JobPostingCompetency[]
  questionCompetencies   QuestionCompetency[]
  planModules            InterviewPlanModule[]
  rubricCriteria         RubricCriterion[]
  competencyScores       CompetencyScore[]
}

model SeniorityLevel {
  id                 String              @id @default(cuid())
  slug               String              @unique
  label              String
  displayOrder       Int                 @default(0)
  isActive           Boolean             @default(true)
  interviewPlans     InterviewPlan[]
  interviewSessions  InterviewSession[]
  jobPostingVersions JobPostingVersion[]
  questions          Question[]

  @@index([isActive, displayOrder])
}

model InterviewStage {
  id                String             @id @default(cuid())
  slug              String             @unique
  label             String
  displayOrder      Int                @default(0)
  isActive          Boolean            @default(true)
  interviewPlans    InterviewPlan[]
  interviewSessions InterviewSession[]

  @@index([isActive, displayOrder])
}

model ContentSource {
  id                 String              @id @default(cuid())
  type               ContentSourceType
  title              String
  publisher          String?
  url                String?
  publishedAt        DateTime?
  retrievedAt        DateTime?
  isOfficial         Boolean             @default(false)
  researchNotes      String?             @db.Text
  confidence         ConfidenceLevel     @default(low)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  jobPostingVersions JobPostingVersion[]
  questionCompanies  QuestionCompany[]
  contentReviews     ContentReview[]

  @@index([type, isOfficial])
  @@index([url])
}

model ContentReview {
  id                  String             @id @default(cuid())
  status              ContentStatus
  reviewerId          String?            @db.Uuid
  contentSourceId     String?
  companyId           String?
  jobPostingVersionId String?
  questionId          String?
  rubricId            String?
  reviewedAt          DateTime?
  notes               String?            @db.Text
  nextReviewAt        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reviewer            User?              @relation("ContentReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  contentSource       ContentSource?     @relation(fields: [contentSourceId], references: [id], onDelete: SetNull)
  company             Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobPostingVersion   JobPostingVersion? @relation(fields: [jobPostingVersionId], references: [id], onDelete: SetNull)
  question            Question?          @relation(fields: [questionId], references: [id], onDelete: SetNull)
  rubric              Rubric?            @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  @@index([status, nextReviewAt])
  @@index([reviewerId, reviewedAt])
  @@index([contentSourceId])
  @@index([companyId])
  @@index([jobPostingVersionId])
  @@index([questionId])
  @@index([rubricId])
}

model JobSource {
  id                String              @id @default(cuid())
  type              ContentSourceType
  name              String
  url               String?
  isAuthorized      Boolean             @default(false)
  submittedByUserId String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  submittedByUser   User?               @relation("CandidateSubmittedJobSources", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  jobPostings       JobPosting[]
  versions          JobPostingVersion[]

  @@index([type, isAuthorized])
  @@index([submittedByUserId])
}

model JobPosting {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  companyId          String
  marketId           String
  roleFamilyId       String
  jobRoleId          String?
  jobSourceId        String?
  status             JobPostingStatus       @default(draft)
  firstSeenAt        DateTime               @default(now())
  lastVerifiedAt     DateTime?
  closesAt           DateTime?
  publishedAt        DateTime?
  retiredAt          DateTime?
  currentVersionId   String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  market             Market                 @relation(fields: [marketId], references: [id], onDelete: Restrict)
  roleFamily         RoleFamily             @relation(fields: [roleFamilyId], references: [id], onDelete: Restrict)
  jobRole            JobRole?               @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  jobSource          JobSource?             @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  currentVersion     JobPostingVersion?     @relation("CurrentJobPostingVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions           JobPostingVersion[]    @relation("JobPostingVersions")
  publicationReviews JobPublicationReview[]
  auditEvents        JobPostingAuditEvent[]
  savedJobs          SavedJob[]

  @@index([marketId, status, lastVerifiedAt])
  @@index([companyId, status])
  @@index([roleFamilyId, status])
  @@index([jobRoleId, status])
  @@index([closesAt])
}

model JobPostingVersion {
  id                               String                              @id @default(cuid())
  jobPostingId                     String
  version                          Int
  title                            String
  description                      String                              @db.Text
  responsibilities                 String[]                            @default([])
  requirements                     String[]                            @default([])
  preferredQualifications          String[]                            @default([])
  location                         String?
  workType                         WorkType?
  employmentType                   EmploymentType?
  seniorityLevelId                 String?
  salaryMinAmount                  Int?
  salaryMaxAmount                  Int?
  salaryCurrency                   String?
  salaryPeriod                     SalaryPeriod?
  contentSourceId                  String?
  jobSourceId                      String?
  applicationUrl                   String
  applicationUrlHost               String?
  applicationUrlVerifiedAt         DateTime?
  applicationUrlVerificationStatus JobApplicationUrlVerificationStatus @default(unchecked)
  applicationVerificationEvidence  Json?
  sourceUrl                        String?                             @db.Text
  sourceUrlHost                    String?
  sourceExternalId                 String?
  normalizedTitle                  String?
  normalizedLocation               String?
  riskFlags                        String[]                            @default([])
  sanitizedContentHash             String?
  sourcePublishedAt                DateTime?
  sourceRetrievedAt                DateTime?
  contentHash                      String
  createdAt                        DateTime                            @default(now())
  posting                          JobPosting                          @relation("JobPostingVersions", fields: [jobPostingId], references: [id], onDelete: Cascade)
  currentForPosting                JobPosting?                         @relation("CurrentJobPostingVersion")
  seniorityLevel                   SeniorityLevel?                     @relation(fields: [seniorityLevelId], references: [id], onDelete: SetNull)
  contentSource                    ContentSource?                      @relation(fields: [contentSourceId], references: [id], onDelete: SetNull)
  jobSource                        JobSource?                          @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  skills                           JobPostingSkill[]
  competencies                     JobPostingCompetency[]
  publicationReviews               JobPublicationReview[]
  auditEvents                      JobPostingAuditEvent[]
  privateTargetVersions            PrivateJobTargetVersion[]
  tailoringRuns                    TailoringRun[]
  jobApplications                  JobApplication[]
  outboundEvents                   ApplicationOutboundEvent[]
  interviewSessions                InterviewSession[]
  contentReviews                   ContentReview[]
  savedJobs                        SavedJob[]

  @@unique([jobPostingId, version])
  @@unique([jobPostingId, contentHash])
  @@index([contentHash])
  @@index([applicationUrlHost])
  @@index([sourceUrlHost])
  @@index([sourceExternalId])
  @@index([normalizedTitle])
  @@index([contentSourceId])
  @@index([jobSourceId])
  @@index([seniorityLevelId])
}

model JobPostingSkill {
  id                  String             @id @default(cuid())
  jobPostingVersionId String
  skillId             String
  importance          JobSkillImportance
  evidence            String?            @db.Text
  createdAt           DateTime           @default(now())
  jobPostingVersion   JobPostingVersion  @relation(fields: [jobPostingVersionId], references: [id], onDelete: Cascade)
  skill               Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobPostingVersionId, skillId, importance])
  @@index([skillId, importance])
}

model JobPostingCompetency {
  id                  String            @id @default(cuid())
  jobPostingVersionId String
  competencyId        String
  weight              Int               @default(1)
  evidence            String?           @db.Text
  createdAt           DateTime          @default(now())
  jobPostingVersion   JobPostingVersion @relation(fields: [jobPostingVersionId], references: [id], onDelete: Cascade)
  competency          Competency        @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([jobPostingVersionId, competencyId])
  @@index([competencyId, weight])
}

model JobPublicationReview {
  id                  String                    @id @default(cuid())
  jobPostingId        String
  jobPostingVersionId String
  sourceDecision      PublicationReviewDecision @default(pending)
  duplicateDecision   PublicationReviewDecision @default(pending)
  applicationDecision PublicationReviewDecision @default(pending)
  freshnessDecision   PublicationReviewDecision @default(pending)
  publicationDecision PublicationReviewDecision @default(pending)
  expiryDecision      PublicationReviewDecision @default(pending)
  notes               String?                   @db.Text
  reviewedByUserId    String?                   @db.Uuid
  reviewedAt          DateTime?
  nextReviewAt        DateTime?
  createdAt           DateTime                  @default(now())
  jobPosting          JobPosting                @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingVersion   JobPostingVersion         @relation(fields: [jobPostingVersionId], references: [id], onDelete: Cascade)

  @@index([jobPostingId, createdAt])
  @@index([jobPostingVersionId, createdAt])
  @@index([publicationDecision, nextReviewAt])
  @@index([reviewedByUserId])
}

model JobPostingAuditEvent {
  id                  String                @id @default(cuid())
  jobPostingId        String
  jobPostingVersionId String?
  actorUserId         String?               @db.Uuid
  action              JobPostingAuditAction
  fromStatus          JobPostingStatus?
  toStatus            JobPostingStatus?
  reason              String?               @db.Text
  metadata            Json?
  createdAt           DateTime              @default(now())
  jobPosting          JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  jobPostingVersion   JobPostingVersion?    @relation(fields: [jobPostingVersionId], references: [id], onDelete: SetNull)
  actor               User?                 @relation("JobPostingAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([jobPostingId, createdAt])
  @@index([jobPostingVersionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model PrivateJobTarget {
  id               String                    @id @default(cuid())
  userId           String                    @db.Uuid
  marketId         String?
  companyId        String?
  jobRoleId        String?
  title            String
  currentVersionId String?                   @unique
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  market           Market?                   @relation(fields: [marketId], references: [id], onDelete: SetNull)
  company          Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobRole          JobRole?                  @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  currentVersion   PrivateJobTargetVersion?  @relation("CurrentPrivateJobTargetVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         PrivateJobTargetVersion[] @relation("PrivateJobTargetVersions")

  @@index([userId, deletedAt, updatedAt])
  @@index([marketId])
  @@index([companyId])
  @@index([jobRoleId])
}

model PrivateJobTargetVersion {
  id                        String             @id @default(cuid())
  privateJobTargetId        String
  sourceJobPostingVersionId String?
  version                   Int
  companyName               String?
  roleTitle                 String
  description               String?            @db.Text
  requirements              String[]           @default([])
  skills                    Json?
  contentHash               String
  createdAt                 DateTime           @default(now())
  privateJobTarget          PrivateJobTarget   @relation("PrivateJobTargetVersions", fields: [privateJobTargetId], references: [id], onDelete: Cascade)
  currentForTarget          PrivateJobTarget?  @relation("CurrentPrivateJobTargetVersion")
  sourceJobPostingVersion   JobPostingVersion? @relation(fields: [sourceJobPostingVersionId], references: [id], onDelete: SetNull)
  tailoringRuns             TailoringRun[]
  jobApplications           JobApplication[]
  interviewSessions         InterviewSession[]

  @@unique([privateJobTargetId, version])
  @@unique([privateJobTargetId, contentHash])
  @@index([sourceJobPostingVersionId])
}

model CandidateDocument {
  id               String                     @id @default(cuid())
  userId           String                     @db.Uuid
  kind             CandidateDocumentKind      @default(cv)
  title            String
  status           CandidateDocumentStatus    @default(active)
  currentVersionId String?                    @unique
  deletedAt        DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVersion   CandidateDocumentVersion?  @relation("CurrentCandidateDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         CandidateDocumentVersion[] @relation("CandidateDocumentVersions")
  facts            CandidateFact[]

  @@index([userId, status, updatedAt])
}

model CandidateDocumentUploadReservation {
  id                String                             @id @default(cuid())
  userId            String                             @db.Uuid
  idempotencyKey    String                             @unique
  expectedBucket    String
  expectedKey       String
  expectedMimeType  String
  expectedExtension String
  expectedSizeBytes Int
  checksumSha256    String?
  originalFileName  String
  documentTitle     String
  documentKind      CandidateDocumentKind              @default(cv)
  status            DocumentUploadReservationStatus    @default(reserved)
  createdAt         DateTime                           @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  rejectedAt        DateTime?
  user              User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingEvents  CandidateDocumentProcessingEvent[]

  @@unique([expectedBucket, expectedKey])
  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model CandidateDocumentProcessingEvent {
  id                  String                              @id @default(cuid())
  eventId             String                              @unique
  userId              String?                             @db.Uuid
  uploadReservationId String?
  documentVersionId   String?
  quarantineBucket    String
  quarantineKey       String
  status              DocumentProcessingEventStatus       @default(processing)
  attempts            Int                                 @default(0)
  failureCode         String?
  failureMessage      String?                             @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  user                User?                               @relation(fields: [userId], references: [id], onDelete: SetNull)
  uploadReservation   CandidateDocumentUploadReservation? @relation(fields: [uploadReservationId], references: [id], onDelete: SetNull)
  documentVersion     CandidateDocumentVersion?           @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([uploadReservationId])
  @@index([documentVersionId])
  @@index([quarantineBucket, quarantineKey])
}

model CandidateDocumentVersion {
  id                           String                             @id @default(cuid())
  userId                       String                             @db.Uuid
  documentId                   String
  sourceVersionId              String?
  version                      Int
  status                       CandidateDocumentVersionStatus     @default(quarantined)
  r2Bucket                     String
  r2Key                        String
  r2Etag                       String?
  checksumSha256               String?
  contentHash                  String?
  mimeType                     String
  sizeBytes                    Int
  scanStatus                   DocumentScanStatus                 @default(pending)
  scanProvider                 String?
  scanVersion                  String?
  parserProvider               String?
  parserVersion                String?
  structuredFactsSchemaVersion String?
  parsedTextHash               String?
  processingEvidence           Json?
  rejectionCode                String?
  rejectionMessage             String?                            @db.Text
  createdAt                    DateTime                           @default(now())
  deletedAt                    DateTime?
  user                         User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document                     CandidateDocument                  @relation("CandidateDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument           CandidateDocument?                 @relation("CurrentCandidateDocumentVersion")
  sourceVersion                CandidateDocumentVersion?          @relation("CandidateDocumentDerivation", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions              CandidateDocumentVersion[]         @relation("CandidateDocumentDerivation")
  facts                        CandidateFact[]
  sourceTailoringRuns          TailoringRun[]                     @relation("TailoringSourceDocumentVersion")
  outputTailoringRun           TailoringRun?                      @relation("TailoringOutputDocumentVersion")
  tailoringExports             TailoringExport[]
  jobApplications              JobApplication[]
  interviewSessions            InterviewSession[]
  storageUsages                StorageUsage[]
  processingEvents             CandidateDocumentProcessingEvent[]

  @@unique([r2Bucket, r2Key])
  @@unique([documentId, version])
  @@index([userId, status, createdAt])
  @@index([documentId, createdAt])
  @@index([contentHash])
  @@index([sourceVersionId])
}

model CandidateFact {
  id                      String                      @id @default(cuid())
  userId                  String                      @db.Uuid
  documentId              String?
  sourceDocumentVersionId String?
  skillId                 String?
  type                    CandidateFactType
  evidenceSource          CandidateFactEvidenceSource
  label                   String
  normalizedData          Json?
  sourceExcerpt           String?                     @db.Text
  userConfirmedAt         DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document                CandidateDocument?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceDocumentVersion   CandidateDocumentVersion?   @relation(fields: [sourceDocumentVersionId], references: [id], onDelete: SetNull)
  skill                   Skill?                      @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([documentId])
  @@index([sourceDocumentVersionId])
  @@index([skillId])
}

model TailoringRun {
  id                        String                    @id @default(cuid())
  userId                    String                    @db.Uuid
  sourceDocumentVersionId   String
  targetType                TailoringTargetType
  jobPostingVersionId       String?
  privateJobTargetVersionId String?
  outputDocumentVersionId   String?                   @unique
  companyName               String?
  roleTitle                 String?
  promptVersion             String
  modelProvider             String?
  modelName                 String?
  status                    TailoringStatus           @default(queued)
  matchAnalysis             Json?
  suggestions               Json?
  usage                     Json?
  estimatedCostAmount       Decimal?                  @db.Decimal(18, 8)
  estimatedCostCurrency     String?
  idempotencyKey            String?                   @unique
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  completedAt               DateTime?
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocumentVersion     CandidateDocumentVersion  @relation("TailoringSourceDocumentVersion", fields: [sourceDocumentVersionId], references: [id], onDelete: Restrict)
  jobPostingVersion         JobPostingVersion?        @relation(fields: [jobPostingVersionId], references: [id], onDelete: SetNull)
  privateJobTargetVersion   PrivateJobTargetVersion?  @relation(fields: [privateJobTargetVersionId], references: [id], onDelete: SetNull)
  outputDocumentVersion     CandidateDocumentVersion? @relation("TailoringOutputDocumentVersion", fields: [outputDocumentVersionId], references: [id], onDelete: SetNull)
  editDecisions             TailoringEditDecision[]
  exports                   TailoringExport[]
  modelUsages               ModelUsage[]
  creditLedgerEntries       CreditLedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([sourceDocumentVersionId])
  @@index([jobPostingVersionId])
  @@index([privateJobTargetVersionId])
}

model TailoringExport {
  id                    String                    @id @default(cuid())
  userId                String                    @db.Uuid
  tailoringRunId        String
  documentVersionId     String?
  format                TailoringExportFormat
  r2Bucket              String
  r2Key                 String
  r2Etag                String?
  checksumSha256        String?
  contentHash           String?
  mimeType              String
  sizeBytes             Int
  accessibilityEvidence Json?
  createdAt             DateTime                  @default(now())
  deletedAt             DateTime?
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoringRun          TailoringRun              @relation(fields: [tailoringRunId], references: [id], onDelete: Cascade)
  documentVersion       CandidateDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@unique([tailoringRunId, format])
  @@unique([r2Bucket, r2Key])
  @@index([userId, createdAt])
  @@index([documentVersionId])
  @@index([format, deletedAt])
}

model TailoringEditDecision {
  id             String                    @id @default(cuid())
  tailoringRunId String
  userId         String                    @db.Uuid
  suggestionKey  String
  decision       TailoringEditDecisionType
  acceptedText   String?                   @db.Text
  userEditedText String?                   @db.Text
  createdAt      DateTime                  @default(now())
  tailoringRun   TailoringRun              @relation(fields: [tailoringRunId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tailoringRunId, suggestionKey])
  @@index([userId, createdAt])
}

model SavedJob {
  id             String             @id @default(cuid())
  userId         String             @db.Uuid
  jobPostingId   String
  savedVersionId String?
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting     JobPosting         @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  savedVersion   JobPostingVersion? @relation(fields: [savedVersionId], references: [id], onDelete: SetNull)

  @@unique([userId, jobPostingId])
  @@index([userId, deletedAt, createdAt])
  @@index([savedVersionId])
}

model JobApplication {
  id                        String                     @id @default(cuid())
  userId                    String                     @db.Uuid
  jobPostingVersionId       String?
  privateJobTargetVersionId String?
  documentVersionId         String?
  currentStatus             ApplicationStatus          @default(interested)
  appliedAt                 DateTime?
  nextActionAt              DateTime?
  reminderEnabled           Boolean                    @default(false)
  reminderLeadDays          Int?
  reminderTimeZone          String?
  notes                     String?                    @db.Text
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingVersion         JobPostingVersion?         @relation(fields: [jobPostingVersionId], references: [id], onDelete: SetNull)
  privateJobTargetVersion   PrivateJobTargetVersion?   @relation(fields: [privateJobTargetVersionId], references: [id], onDelete: SetNull)
  documentVersion           CandidateDocumentVersion?  @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  statusEvents              ApplicationStatusEvent[]
  outboundEvents            ApplicationOutboundEvent[]

  @@index([userId, currentStatus, updatedAt])
  @@index([jobPostingVersionId])
  @@index([privateJobTargetVersionId])
  @@index([documentVersionId])
}

model ApplicationStatusEvent {
  id            String             @id @default(cuid())
  applicationId String
  userId        String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?            @db.Text
  occurredAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())
  application   JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@index([userId, occurredAt])
}

model ApplicationOutboundEvent {
  id                  String            @id @default(cuid())
  userId              String?           @db.Uuid
  jobApplicationId    String?
  jobPostingVersionId String
  destinationHost     String
  destinationHash     String
  userAgentHash       String?
  occurredAt          DateTime          @default(now())
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobApplication      JobApplication?   @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  jobPostingVersion   JobPostingVersion @relation(fields: [jobPostingVersionId], references: [id], onDelete: Restrict)

  @@index([jobPostingVersionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([jobApplicationId])
}

model EvaluationFramework {
  id             String                @id @default(cuid())
  key            String                @unique
  name           String
  description    String?               @db.Text
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  planModules    InterviewPlanModule[]
  questions      Question[]
  rubrics        Rubric[]
  interviewTurns InterviewTurn[]

  @@index([isActive, key])
}

model InterviewPlan {
  id                 String                @id @default(cuid())
  slug               String
  version            Int
  marketId           String?
  companyId          String?
  roleFamilyId       String
  jobRoleId          String?
  seniorityLevelId   String
  interviewStageId   String?
  focusMode          InterviewFocusMode    @default(recommended)
  status             ContentStatus         @default(draft)
  promptVersion      String
  questionSetVersion String
  rubricVersion      String
  rationale          String?               @db.Text
  createdAt          DateTime              @default(now())
  retiredAt          DateTime?
  market             Market?               @relation(fields: [marketId], references: [id], onDelete: SetNull)
  company            Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roleFamily         RoleFamily            @relation(fields: [roleFamilyId], references: [id], onDelete: Restrict)
  jobRole            JobRole?              @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  seniorityLevel     SeniorityLevel        @relation(fields: [seniorityLevelId], references: [id], onDelete: Restrict)
  interviewStage     InterviewStage?       @relation(fields: [interviewStageId], references: [id], onDelete: SetNull)
  modules            InterviewPlanModule[]
  interviewSessions  InterviewSession[]

  @@unique([slug, version])
  @@index([status, roleFamilyId, seniorityLevelId])
  @@index([marketId, companyId, jobRoleId])
}

model InterviewPlanModule {
  id                    String              @id @default(cuid())
  interviewPlanId       String
  evaluationFrameworkId String
  competencyId          String?
  weight                Int
  displayOrder          Int                 @default(0)
  rubricKey             String?
  selectionRules        Json?
  interviewPlan         InterviewPlan       @relation(fields: [interviewPlanId], references: [id], onDelete: Cascade)
  evaluationFramework   EvaluationFramework @relation(fields: [evaluationFrameworkId], references: [id], onDelete: Restrict)
  competency            Competency?         @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  @@unique([interviewPlanId, evaluationFrameworkId, competencyId])
  @@index([evaluationFrameworkId])
  @@index([competencyId])
}

model Question {
  id                    String               @id @default(cuid())
  slug                  String
  version               Int
  prompt                String               @db.Text
  evaluationFrameworkId String
  industryId            String?
  difficulty            String?
  seniorityLevelId      String?
  followUpToQuestionId  String?
  publicationStatus     ContentStatus        @default(draft)
  confidence            ConfidenceLevel      @default(low)
  reviewedAt            DateTime?
  nextReviewAt          DateTime?
  createdAt             DateTime             @default(now())
  retiredAt             DateTime?
  evaluationFramework   EvaluationFramework  @relation(fields: [evaluationFrameworkId], references: [id], onDelete: Restrict)
  industry              Industry?            @relation(fields: [industryId], references: [id], onDelete: SetNull)
  seniorityLevel        SeniorityLevel?      @relation(fields: [seniorityLevelId], references: [id], onDelete: SetNull)
  followUpToQuestion    Question?            @relation("QuestionFollowUps", fields: [followUpToQuestionId], references: [id], onDelete: SetNull)
  followUps             Question[]           @relation("QuestionFollowUps")
  variants              QuestionVariant[]
  companies             QuestionCompany[]
  roles                 QuestionRole[]
  competencies          QuestionCompetency[]
  strongAnswerSignals   StrongAnswerSignal[]
  redFlags              RedFlag[]
  followUpRules         FollowUpRule[]
  rubrics               Rubric[]
  contentReviews        ContentReview[]
  interviewTurns        InterviewTurn[]

  @@unique([slug, version])
  @@index([publicationStatus, nextReviewAt])
  @@index([evaluationFrameworkId, difficulty])
  @@index([seniorityLevelId])
  @@index([industryId])
}

model QuestionCompany {
  id         String         @id @default(cuid())
  questionId String
  companyId  String
  sourceId   String?
  weight     Int            @default(1)
  rationale  String?        @db.Text
  createdAt  DateTime       @default(now())
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     ContentSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([questionId, companyId])
  @@index([companyId, weight])
  @@index([sourceId])
}

model QuestionRole {
  id           String      @id @default(cuid())
  questionId   String
  roleFamilyId String?
  jobRoleId    String?
  weight       Int         @default(1)
  rationale    String?     @db.Text
  createdAt    DateTime    @default(now())
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  roleFamily   RoleFamily? @relation(fields: [roleFamilyId], references: [id], onDelete: Cascade)
  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@index([roleFamilyId, weight])
  @@index([jobRoleId, weight])
  @@index([questionId])
}

model QuestionCompetency {
  id           String     @id @default(cuid())
  questionId   String
  competencyId String
  weight       Int        @default(1)
  rationale    String?    @db.Text
  createdAt    DateTime   @default(now())
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([questionId, competencyId])
  @@index([competencyId, weight])
}

model QuestionVariant {
  id         String   @id @default(cuid())
  questionId String
  locale     String   @default("en")
  prompt     String   @db.Text
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
}

model StrongAnswerSignal {
  id           String   @id @default(cuid())
  questionId   String
  label        String
  description  String   @db.Text
  displayOrder Int      @default(0)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, displayOrder])
}

model RedFlag {
  id           String   @id @default(cuid())
  questionId   String
  label        String
  description  String   @db.Text
  severity     Int      @default(1)
  displayOrder Int      @default(0)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, severity])
}

model FollowUpRule {
  id           String         @id @default(cuid())
  questionId   String
  intent       FollowUpIntent
  condition    String         @db.Text
  promptHint   String         @db.Text
  displayOrder Int            @default(0)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, intent])
}

model Rubric {
  id                    String              @id @default(cuid())
  key                   String
  version               Int
  evaluationFrameworkId String
  questionId            String?
  label                 String
  description           String?             @db.Text
  status                ContentStatus       @default(draft)
  createdAt             DateTime            @default(now())
  retiredAt             DateTime?
  evaluationFramework   EvaluationFramework @relation(fields: [evaluationFrameworkId], references: [id], onDelete: Restrict)
  question              Question?           @relation(fields: [questionId], references: [id], onDelete: SetNull)
  criteria              RubricCriterion[]
  contentReviews        ContentReview[]
  interviewTurns        InterviewTurn[]

  @@unique([key, version])
  @@index([evaluationFrameworkId, status])
  @@index([questionId])
}

model RubricCriterion {
  id           String      @id @default(cuid())
  rubricId     String
  competencyId String?
  key          String
  label        String
  description  String      @db.Text
  weight       Int
  minScore     Int         @default(0)
  maxScore     Int         @default(5)
  displayOrder Int         @default(0)
  rubric       Rubric      @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  competency   Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  @@unique([rubricId, key])
  @@index([competencyId])
}

model InterviewSession {
  id                          String                    @id @default(cuid())
  userId                      String                    @db.Uuid
  visaTypeId                  String?
  originCountryId             String?
  previousRejections          String                    @default("None")
  onboardingData              Json                      @default("{}")
  concerns                    String?
  difficulty                  String                    @default("Realistic")
  status                      SessionStatus             @default(ongoing)
  score                       Int?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime?                 @updatedAt
  sessionKind                 InterviewSessionKind      @default(legacy_visa)
  marketId                    String?
  companyId                   String?
  roleFamilyId                String?
  jobRoleId                   String?
  seniorityLevelId            String?
  interviewStageId            String?
  jobPostingVersionId         String?
  privateJobTargetVersionId   String?
  candidateDocumentVersionId  String?
  useCandidateDocumentContext Boolean                   @default(false)
  interviewPlanId             String?
  focusMode                   InterviewFocusMode?
  interviewMode               InterviewMode?
  language                    String                    @default("en")
  questionSetVersion          String?
  rubricVersion               String?
  promptVersion               String?
  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType                    VisaType?                 @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  originCountry               Country?                  @relation("OriginCountryInterviews", fields: [originCountryId], references: [id], onDelete: Cascade)
  market                      Market?                   @relation(fields: [marketId], references: [id], onDelete: SetNull)
  company                     Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roleFamily                  RoleFamily?               @relation(fields: [roleFamilyId], references: [id], onDelete: SetNull)
  jobRole                     JobRole?                  @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  seniorityLevel              SeniorityLevel?           @relation(fields: [seniorityLevelId], references: [id], onDelete: SetNull)
  interviewStage              InterviewStage?           @relation(fields: [interviewStageId], references: [id], onDelete: SetNull)
  jobPostingVersion           JobPostingVersion?        @relation(fields: [jobPostingVersionId], references: [id], onDelete: SetNull)
  privateJobTargetVersion     PrivateJobTargetVersion?  @relation(fields: [privateJobTargetVersionId], references: [id], onDelete: SetNull)
  candidateDocumentVersion    CandidateDocumentVersion? @relation(fields: [candidateDocumentVersionId], references: [id], onDelete: SetNull)
  interviewPlan               InterviewPlan?            @relation(fields: [interviewPlanId], references: [id], onDelete: SetNull)
  messages                    Message[]
  report                      Report?
  realtimeInterview           RealtimeInterview?
  interviewTurns              InterviewTurn[]
  interviewReports            InterviewReport[]
  creditLedgerEntries         CreditLedgerEntry[]
  modelUsages                 ModelUsage[]

  @@index([userId, createdAt])
  @@index([sessionKind, status, createdAt])
  @@index([marketId, roleFamilyId, seniorityLevelId])
  @@index([companyId, jobRoleId])
  @@index([jobPostingVersionId])
  @@index([privateJobTargetVersionId])
  @@index([candidateDocumentVersionId])
  @@index([interviewPlanId])
}

model RealtimeInterview {
  id               String                   @id @default(cuid())
  sessionId        String                   @unique
  model            String
  voice            String
  openingQuestion  String                   @db.Text
  status           RealtimeInterviewStatus  @default(pending)
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  completionReason String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  session          InterviewSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turns            RealtimeTranscriptTurn[]
  events           RealtimeInterviewEvent[]

  @@index([status, createdAt])
}

model RealtimeTranscriptTurn {
  id                  String            @id @default(cuid())
  realtimeInterviewId String
  sequence            Int
  question            String            @db.Text
  answer              String?           @db.Text
  evaluation          Json?
  createdAt           DateTime          @default(now())
  realtimeInterview   RealtimeInterview @relation(fields: [realtimeInterviewId], references: [id], onDelete: Cascade)

  @@unique([realtimeInterviewId, sequence])
  @@index([realtimeInterviewId, createdAt])
}

model RealtimeInterviewEvent {
  id                  String            @id @default(cuid())
  realtimeInterviewId String
  sequence            Int
  type                String
  payload             Json?
  createdAt           DateTime          @default(now())
  realtimeInterview   RealtimeInterview @relation(fields: [realtimeInterviewId], references: [id], onDelete: Cascade)

  @@unique([realtimeInterviewId, sequence])
  @@index([realtimeInterviewId, createdAt])
}

model Message {
  id        String           @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String           @db.Text
  metadata  Json?
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model InterviewTurn {
  id                    String               @id @default(cuid())
  sessionId             String
  sequence              Int
  questionId            String?
  renderedQuestion      String               @db.Text
  evaluationFrameworkId String?
  rubricId              String?
  rubricVersion         String?
  selectionLevel        String?
  selectionReason       String?              @db.Text
  candidateAnswer       String?              @db.Text
  structuredEvaluation  Json?
  startedAt             DateTime?
  answeredAt            DateTime?
  createdAt             DateTime             @default(now())
  session               InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question              Question?            @relation(fields: [questionId], references: [id], onDelete: SetNull)
  evaluationFramework   EvaluationFramework? @relation(fields: [evaluationFrameworkId], references: [id], onDelete: SetNull)
  rubric                Rubric?              @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  starScores            StarScore[]
  technicalScores       TechnicalScore[]

  @@unique([sessionId, sequence])
  @@index([questionId])
  @@index([evaluationFrameworkId])
  @@index([rubricId])
}

model Report {
  id                     String           @id @default(cuid())
  sessionId              String           @unique
  evidenceStatus         String           @default("complete")
  answeredQuestions      Int              @default(0)
  score                  Int
  answerConsistency      Int
  homeTiesStrength       Int
  returnIntentClarity    Int
  financialClarity       Int
  studyPurpose           Int
  composureUnderPressure Int
  summary                String           @db.Text
  keyWeaknesses          String[]         @default([])
  suggestions            String[]         @default([])
  createdAt              DateTime         @default(now())
  session                InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewReport {
  id                String            @id @default(cuid())
  sessionId         String
  version           Int
  evidenceStatus    String            @default("complete")
  answeredQuestions Int               @default(0)
  score             Int?
  summary           String            @db.Text
  strengths         String[]          @default([])
  priorities        String[]          @default([])
  actions           String[]          @default([])
  reportVersion     String
  promptVersion     String?
  rubricVersion     String?
  provider          String?
  modelName         String?
  rawSnapshot       Json?
  createdAt         DateTime          @default(now())
  session           InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  competencyScores  CompetencyScore[]
  starScores        StarScore[]
  technicalScores   TechnicalScore[]

  @@unique([sessionId, version])
  @@index([sessionId, createdAt])
  @@index([evidenceStatus, score])
}

model CompetencyScore {
  id                String          @id @default(cuid())
  interviewReportId String
  competencyId      String
  score             Int?
  evidenceExcerpts  String[]        @default([])
  explanation       String          @db.Text
  createdAt         DateTime        @default(now())
  interviewReport   InterviewReport @relation(fields: [interviewReportId], references: [id], onDelete: Cascade)
  competency        Competency      @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([interviewReportId, competencyId])
  @@index([competencyId, score])
}

model StarScore {
  id                String              @id @default(cuid())
  interviewReportId String
  interviewTurnId   String?
  situationStatus   StarComponentStatus @default(missing)
  situationScore    Int?
  situationEvidence String?             @db.Text
  taskStatus        StarComponentStatus @default(missing)
  taskScore         Int?
  taskEvidence      String?             @db.Text
  actionStatus      StarComponentStatus @default(missing)
  actionScore       Int?
  actionEvidence    String?             @db.Text
  resultStatus      StarComponentStatus @default(missing)
  resultScore       Int?
  resultEvidence    String?             @db.Text
  createdAt         DateTime            @default(now())
  interviewReport   InterviewReport     @relation(fields: [interviewReportId], references: [id], onDelete: Cascade)
  interviewTurn     InterviewTurn?      @relation(fields: [interviewTurnId], references: [id], onDelete: SetNull)

  @@index([interviewReportId])
  @@index([interviewTurnId])
}

model TechnicalScore {
  id                String          @id @default(cuid())
  interviewReportId String
  interviewTurnId   String?
  frameworkKey      String
  accuracy          Int?
  completeness      Int?
  clarity           Int?
  mechanism         Int?
  practicalUse      Int?
  depth             Int?
  tradeOffs         Int?
  evidenceExcerpts  String[]        @default([])
  explanation       String          @db.Text
  criteriaSnapshot  Json?
  createdAt         DateTime        @default(now())
  interviewReport   InterviewReport @relation(fields: [interviewReportId], references: [id], onDelete: Cascade)
  interviewTurn     InterviewTurn?  @relation(fields: [interviewTurnId], references: [id], onDelete: SetNull)

  @@index([interviewReportId, frameworkKey])
  @@index([interviewTurnId])
}

model PracticeQuestion {
  id            String   @id @default(cuid())
  slug          String   @unique
  visaType      String
  type          String   @default("mcq")
  question      String   @db.Text
  options       String[]
  correctAnswer String
  explanation   String   @db.Text
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visaType, type, isActive, displayOrder])
}

model Purchase {
  id                       String                   @id @default(cuid())
  userId                   String                   @db.Uuid
  provider                 PaymentProvider          @default(flutterwave)
  stripeCheckoutSessionId  String?                  @unique
  flutterwaveTxRef         String?                  @unique
  flutterwaveTransactionId String?                  @unique
  plan                     String                   @default("monthly")
  planDays                 Int                      @default(30)
  accessExpiresAt          DateTime?
  amount                   Int
  currency                 String
  creditsGranted           Int                      @default(0)
  referredByUserId         String?                  @db.Uuid
  productAction            LedgerProductAction?
  fulfillmentState         PurchaseFulfillmentState @default(fulfilled)
  idempotencyKey           String?                  @unique
  createdAt                DateTime                 @default(now())
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrer                 User?                    @relation("ReferralPurchases", fields: [referredByUserId], references: [id], onDelete: SetNull)
  ledgerEntries            CreditLedgerEntry[]

  @@index([referredByUserId])
  @@index([userId, createdAt])
  @@index([productAction, fulfillmentState])
}

model PricingPlan {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  productName   String
  productAction LedgerProductAction?
  durationDays  Int
  isActive      Boolean              @default(true)
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  prices        PricingPlanPrice[]

  @@index([productAction, isActive, displayOrder])
}

model PricingPlanPrice {
  id          String      @id @default(cuid())
  planId      String
  countryCode String      @default("DEFAULT")
  currency    String
  amount      Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  plan        PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, countryCode])
  @@index([countryCode])
}

model CreditLedgerEntry {
  id                 String              @id @default(cuid())
  userId             String              @db.Uuid
  purchaseId         String?
  interviewSessionId String?
  tailoringRunId     String?
  action             CreditLedgerAction
  productAction      LedgerProductAction
  units              Int
  balanceAfter       Int?
  idempotencyKey     String              @unique
  relatedEntryId     String?
  expiresAt          DateTime?
  metadata           Json?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase           Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  interviewSession   InterviewSession?   @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)
  tailoringRun       TailoringRun?       @relation(fields: [tailoringRunId], references: [id], onDelete: SetNull)
  relatedEntry       CreditLedgerEntry?  @relation("CreditLedgerRelatedEntries", fields: [relatedEntryId], references: [id], onDelete: SetNull)
  relatedEntries     CreditLedgerEntry[] @relation("CreditLedgerRelatedEntries")

  @@index([userId, productAction, createdAt])
  @@index([purchaseId])
  @@index([interviewSessionId])
  @@index([tailoringRunId])
  @@index([relatedEntryId])
}

model ModelUsage {
  id                  String            @id @default(cuid())
  userId              String?           @db.Uuid
  interviewSessionId  String?
  tailoringRunId      String?
  provider            String
  model               String
  operation           ModelOperation
  modality            ModelModality
  inputTokens         Int?
  outputTokens        Int?
  cachedInputTokens   Int?
  audioSeconds        Int?
  documentBytes       Int?
  estimatedCostAmount Decimal?          @db.Decimal(18, 8)
  currency            String?
  requestIdHash       String?
  createdAt           DateTime          @default(now())
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  interviewSession    InterviewSession? @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)
  tailoringRun        TailoringRun?     @relation(fields: [tailoringRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([operation, model, createdAt])
  @@index([interviewSessionId])
  @@index([tailoringRunId])
}

model StorageUsage {
  id                  String                    @id @default(cuid())
  userId              String?                   @db.Uuid
  documentVersionId   String?
  operation           StorageOperation
  bucket              String
  objectKeyHash       String?
  bytes               Int?
  objectCount         Int                       @default(1)
  estimatedCostAmount Decimal?                  @db.Decimal(18, 8)
  currency            String?
  createdAt           DateTime                  @default(now())
  user                User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentVersion     CandidateDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([documentVersionId])
  @@index([operation, createdAt])
  @@index([bucket])
}
