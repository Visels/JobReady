{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": [
          "PUT",
          "GET",
          "HEAD"
        ],
        "headers": [
          "Content-Type",
          "Content-Length",
          "x-amz-checksum-sha256",
          "x-amz-meta-upload-reservation-id",
          "x-amz-meta-owner-user-hash"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "x-amz-version-id"
      ],
      "maxAgeSeconds": 300
    }
  ]
}
