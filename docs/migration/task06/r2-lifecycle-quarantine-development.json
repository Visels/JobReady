{
  "Rules": [
    {
      "ID": "delete-quarantine-objects-after-one-day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "quarantine/"
      },
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "abort-quarantine-multipart-after-one-day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "quarantine/"
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    }
  ]
}
